{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scriptorium",
  "version": "0.0.1",
  "identifier": "com.lorienweb.scriptorium",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "title": "Scriptorium",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../data/build/bible.db": "bible.db"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
